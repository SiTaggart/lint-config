{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "bun run --filter @sitaggart/lint-config build",
    "lint": "bun run build && oxlint",
    "lint:fix": "bun run build && oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun scripts/prove-release-format.ts && bun run --filter @sitaggart/lint-config check && oxlint && oxfmt --check && bun scripts/prove-packed-consumer.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@sitaggart/lint-config": "workspace:*",
    "dotenv": "18.0.9",
    "husky": "9.1.7",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "precise-commits": "1.0.2"
  },
  "engines": {
    "node": "24.22.2"
  },
  "packageManager": "bun@1.4.4"
}
